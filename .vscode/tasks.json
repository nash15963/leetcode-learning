{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run current question",
            "type": "shell",
            "command": "make run DIR=${fileDirname}",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build current question",
            "type": "shell",
            "command": "make build DIR=${fileDirname}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"]
        }
    ]
}
